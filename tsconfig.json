{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
		"typeRoots": [
			"./types",
			"./node_modules/@types",
			"./node_modules/@yandex/ymaps3-types"
		],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/shared/*"],
			"@entities/*": ["./src/entities/*"],
			"@feature/*": ["./src/feature/*"],
			"@widgets/*": ["./src/widgets/*"],
			"@pages_/*": ["./src/pages_/*"],
			"@app/*": ["./src/app/*"],
		}
  },
  "include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
		"types/**/*",
	],
  "exclude": ["node_modules"]
}
