{
	"name": "cat-energy",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.13.0",
		"npm": "11.6.2"
	},
	"scripts": {
		"server": "tsx --watch backend/src/server.ts",
		"client": "next dev -p 3000",
		"dev": "concurrently \"prisma generate --watch\" \"npm run server\" \"npm run client\"",
		"build": "next build",
		"start": "next start",
		"lint": "npx eslint src/",
		"lint:fix": "npx eslint --fix src/",
		"tsc": "npx tsc",
		"test": "jest",
		"db:generate": "dotenv -e backend/.env.local -- prisma generate",
		"db::studio": "dotenv -e backend/.env.local -- prisma studio",
		"db:pull": "dotenv -e backend/.env.local -- prisma db pull",
		"db:migrate": "dotenv -e backend/.env.local -- prisma migrate dev --name"
	},
	"dependencies": {
		"@prisma/client": "7.3.0",
		"bcrypt": "^6.0.0",
		"classnames": "^2.5.1",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"express-rate-limit": "^8.2.1",
		"helmet": "^8.1.0",
		"next": "^16.1.6",
		"prisma": "7.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@prisma/adapter-pg": "^7.3.0",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-rate-limit": "^5.1.3",
		"@types/node": "^25.1.0",
		"@types/pg": "^8.16.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"babel-plugin-react-compiler": "1.0.0",
		"concurrently": "^9.2.1",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.2",
		"eslint-config-next": "^16.1.6",
		"install": "^0.13.0",
		"jest": "^30.2.0",
		"npm": "^11.8.0",
		"prettier": "^3.8.1",
		"ts-jest": "^29.4.6",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
